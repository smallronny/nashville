---
import { features, services } from '../data/site';
import Icon from './Icon.astro';

const accentClasses = {
  ocean: 'bg-ocean/15 text-ocean-dark',
  coral: 'bg-coral/20 text-coral-dark',
  sun: 'bg-sun/30 text-ink',
  mint: 'bg-mint text-ink',
} as const;
---

<section id="services" class="section relative overflow-hidden bg-paper" aria-labelledby="services-title">
  <div
    class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full border-[28px] border-cream-deep/70"
    aria-hidden="true"
  ></div>

  <div class="container-page relative">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">What we do</p>
        <h2 id="services-title" class="display-title mt-5">
          A craft party for every kind of celebration.
        </h2>
      </div>

      <div class="reveal lg:pb-2" style="--reveal-delay: 90ms">
        <p class="lead max-w-xl">
          We turn your location into a pop-up craft studio, with the materials, projects, and
          guidance handled for you. You bring the guests; we bring the creative fun.
        </p>
        <a href="#contact" class="btn-link mt-6">
          Not sure which party fits? Let's talk
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:gap-6">
      {
        services.map((service, index) => (
          <article
            class="reveal group relative overflow-hidden rounded-[2rem] border border-ink/10 bg-cream p-7 transition duration-300 hover:-translate-y-1.5 hover:shadow-lift sm:p-8"
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <div class="flex items-start justify-between gap-5">
              <span
                class:list={[
                  'flex h-14 w-14 items-center justify-center rounded-2xl transition duration-300 group-hover:-rotate-6',
                  accentClasses[service.accent],
                ]}
              >
                <Icon name={service.icon} size={26} strokeWidth={1.7} />
              </span>
              <span class="font-display text-sm font-semibold text-ink/25">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <h3 class="mt-6 font-display text-2xl font-semibold tracking-[-0.02em] sm:text-[1.7rem]">
              {service.title}
            </h3>
            <p class="mt-3 max-w-md leading-relaxed text-ink/70">{service.description}</p>
          </article>
        ))
      }
    </div>

    <div
      class="reveal mt-8 flex flex-wrap items-center gap-x-7 gap-y-4 rounded-[1.75rem] border border-ink/10 bg-cream px-5 py-5 sm:px-7"
      style="--reveal-delay: 160ms"
    >
      {
        features.map((feature) => (
          <span class="inline-flex items-center gap-2.5 text-sm font-extrabold text-ink/75">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink text-paper">
              <Icon name="check" size={15} strokeWidth={2.4} />
            </span>
            {feature}
          </span>
        ))
      }
    </div>
  </div>
</section>
