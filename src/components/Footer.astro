---
import { Image } from 'astro:assets';
import logo from '../assets/logo-wide.png';
import { navigation, packages, site } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  site.defaultWhatsAppMessage,
)}`;
---

<footer class="relative overflow-hidden border-t-2 border-ink bg-ink text-paper">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -right-32 -top-40 h-96 w-96 rounded-full bg-ocean/15 blur-3xl"></div>
    <div class="dot-grid absolute bottom-10 left-8 h-32 w-32 opacity-10"></div>
  </div>

  <div class="container-page relative py-14 sm:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.25fr_0.7fr_1fr] lg:gap-14">
      <div>
        <a
          href="#top"
          class="inline-flex rounded-2xl bg-paper px-3 py-2 shadow-soft focus-visible:outline-paper"
          aria-label={`${site.name} — back to top`}
        >
          <Image
            src={logo}
            alt={site.name}
            widths={[200, 300]}
            sizes="180px"
            class="h-12 w-auto"
            loading="lazy"
          />
        </a>
        <p class="mt-5 max-w-sm font-display text-2xl font-semibold leading-snug tracking-[-0.02em] text-paper">
          Big creativity for little makers in Nashville.
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-paper/55">
          Mobile craft parties with all the materials, guidance, and happy mess included.
        </p>

        <div class="mt-6 flex items-center gap-2.5">
          <a
            href={site.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/20 text-paper transition hover:border-paper hover:bg-paper hover:text-ink"
            aria-label="Nashville Crafting Club on Instagram"
          >
            <Icon name="instagram" size={18} />
          </a>
          <a
            href={site.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/20 text-paper transition hover:border-paper hover:bg-paper hover:text-ink"
            aria-label="Nashville Crafting Club on Facebook"
          >
            <Icon name="facebook" size={18} />
          </a>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/20 text-paper transition hover:border-paper hover:bg-[#25d366] hover:text-ink"
            aria-label="Nashville Crafting Club on WhatsApp"
          >
            <Icon name="whatsapp" size={18} />
          </a>
        </div>
      </div>

      <nav aria-label="Footer navigation">
        <p class="text-[0.65rem] font-black uppercase tracking-[0.2em] text-paper/40">
          Explore
        </p>
        <ul class="mt-4 space-y-2.5">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm font-bold text-paper/70 transition hover:text-paper hover:underline hover:decoration-coral hover:decoration-2 hover:underline-offset-4"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="#contact"
              class="text-sm font-bold text-paper/70 transition hover:text-paper hover:underline hover:decoration-coral hover:decoration-2 hover:underline-offset-4"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="text-[0.65rem] font-black uppercase tracking-[0.2em] text-paper/40">
          Get in touch
        </p>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={`mailto:${site.email}`}
              class="group inline-flex items-center gap-3 text-sm font-bold text-paper/70 transition hover:text-paper"
            >
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-paper/10 text-paper transition group-hover:bg-paper group-hover:text-ink">
                <Icon name="mail" size={15} />
              </span>
              {site.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${site.phoneHref}`}
              class="group inline-flex items-center gap-3 text-sm font-bold text-paper/70 transition hover:text-paper"
            >
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-paper/10 text-paper transition group-hover:bg-paper group-hover:text-ink">
                <Icon name="phone" size={15} />
              </span>
              {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 text-sm font-bold text-paper/70 transition hover:text-paper"
            >
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-paper/10 text-paper transition group-hover:bg-[#25d366] group-hover:text-ink">
                <Icon name="whatsapp" size={15} />
              </span>
              Chat on WhatsApp
            </a>
          </li>
          <li class="flex items-start gap-3 pt-1 text-sm font-semibold leading-relaxed text-paper/45">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper/10 text-paper/70">
              <Icon name="map-pin" size={15} />
            </span>
            <span>{site.areaServed}</span>
          </li>
        </ul>

        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-1.5 text-xs font-bold text-paper/40">
          {packages.map((pkg) => <span>{pkg.name}</span>)}
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-paper/15 pt-6 text-xs font-semibold text-paper/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <span class="inline-flex items-center gap-1.5">
          Made with
          <Icon name="heart" size={13} class="text-coral" />
          in Nashville
        </span>
        <a
          href="#top"
          class="inline-flex items-center gap-1.5 font-extrabold text-paper/65 transition hover:text-paper"
        >
          Back to top
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </div>
</footer>
