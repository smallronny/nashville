---
import { Image } from 'astro:assets';
import logo from '../assets/logo-wide.png';
import { navCta, navigation, site } from '../data/site';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-cream/90 backdrop-blur-xl">
  <div class="container-page flex h-20 items-center justify-between gap-5">
    <a
      href="#top"
      class="relative z-10 -ml-1 inline-flex shrink-0 items-center rounded-xl focus-visible:outline-offset-4"
      aria-label={`${site.name} — back to top`}
    >
      <Image
        src={logo}
        alt={site.name}
        widths={[160, 240, 320]}
        sizes="(max-width: 640px) 140px, 180px"
        class="h-12 w-auto sm:h-14"
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="relative py-2 text-sm font-extrabold text-ink/70 transition after:absolute after:-bottom-0.5 after:left-0 after:h-0.5 after:w-0 after:rounded-full after:bg-coral after:transition-all after:duration-300 hover:text-ink hover:after:w-full"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href={navCta.href} class="btn btn-primary hidden !min-h-11 !px-5 sm:inline-flex">
        {navCta.label}
        <Icon name="arrow-right" size={17} />
      </a>

      <button
        type="button"
        class="inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-ink/15 bg-paper text-ink transition hover:border-ink/35 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span data-menu-icon-open><Icon name="menu" size={22} /></span>
        <span class="hidden" data-menu-icon-close><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-5rem)] overflow-y-auto border-b border-ink/10 bg-paper shadow-lift lg:hidden"
    data-mobile-menu
    hidden
  >
    <nav class="container-page flex flex-col py-5" aria-label="Mobile navigation">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="border-b border-ink/10 py-4 font-display text-2xl font-semibold tracking-tight transition hover:text-ocean-dark"
          >
            {item.label}
          </a>
        ))
      }

      <a href={navCta.href} class="btn btn-primary mt-6 w-full">
        {navCta.label}
        <Icon name="arrow-right" size={18} />
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-bold text-ink/65">
        <a href={`tel:${site.phoneHref}`} class="inline-flex items-center gap-2 hover:text-ink">
          <Icon name="phone" size={16} />
          {site.phoneDisplay}
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-ink">
          <Icon name="mail" size={16} />
          Email us
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const openIcon = document.querySelector<HTMLElement>('[data-menu-icon-open]');
  const closeIcon = document.querySelector<HTMLElement>('[data-menu-icon-close]');

  if (toggle && menu) {
    const setMenuState = (open: boolean, restoreFocus = false) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);

      if (open) {
        window.setTimeout(() => menu.querySelector<HTMLElement>('a')?.focus(), 50);
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => {
      setMenuState(menu.hasAttribute('hidden'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setMenuState(false, true);
      }
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setMenuState(false);
    });
  }
</script>
