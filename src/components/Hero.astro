---
import { Image } from 'astro:assets';
import heroMain from '../assets/gallery/sand-art.jpeg';
import heroDetail from '../assets/gallery/painting-table-focus.jpg';
import { navCta, site, trustPoints } from '../data/site';
import Icon from './Icon.astro';

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  site.defaultWhatsAppMessage,
)}`;
---

<section class="relative overflow-hidden pb-16 pt-8 sm:pt-12 lg:pb-24 lg:pt-16" aria-labelledby="hero-title">
  <!-- Decorative paper shapes -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -right-32 -top-40 h-[34rem] w-[34rem] rounded-full bg-ocean/10 blur-2xl"></div>
    <div class="absolute -bottom-48 -left-32 h-[28rem] w-[28rem] rounded-full bg-coral/10 blur-2xl"></div>
    <div class="dot-grid absolute left-[46%] top-24 hidden h-40 w-32 opacity-40 lg:block"></div>
    <svg
      class="absolute bottom-24 right-[8%] hidden h-16 w-16 text-coral lg:block"
      viewBox="0 0 64 64"
      fill="none"
    >
      <path
        d="M32 4c2.8 16.8 9.2 23.2 26 26-16.8 2.8-23.2 9.2-26 26-2.8-16.8-9.2-23.2-26-26C22.8 27.2 29.2 20.8 32 4Z"
        stroke="currentColor"
        stroke-width="3"
        stroke-linejoin="round"
      />
    </svg>
  </div>

  <div class="container-page">
    <div class="grid items-center gap-14 lg:grid-cols-[1.04fr_0.96fr] lg:gap-16">
      <div class="relative z-10">
        <p
          class="inline-flex rotate-[-1deg] items-center gap-2 rounded-full border-2 border-ink/15 bg-paper px-4 py-2 text-[0.68rem] font-black uppercase tracking-[0.16em] text-ink/80 shadow-soft"
        >
          <Icon name="map-pin" size={15} class="text-coral" />
          {site.tagline}
        </p>

        <h1
          id="hero-title"
          class="mt-6 font-display text-[clamp(3rem,7.6vw,6.15rem)] font-semibold leading-[0.9] tracking-[-0.045em]"
        >
          Craft parties<br />
          worth getting<br />
          <span class="relative inline-block text-ocean-dark">
            messy
            <svg
              class="absolute -bottom-1 left-0 h-4 w-full text-coral sm:-bottom-2 sm:h-5"
              viewBox="0 0 300 22"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M4 15c46-9 93-11 143-5 51 6 94 4 149-6"
                stroke="currentColor"
                stroke-width="8"
                stroke-linecap="round"
              />
            </svg>
          </span>
          <span class="text-ink"> for.</span>
        </h1>

        <p class="lead mt-7 max-w-xl">
          We bring the paint, slime, sand, and smiles to your Nashville celebration. All the
          materials and guided creative fun are included for up to 10 kids.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={navCta.href} class="btn btn-primary">
            {navCta.label}
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#pricing" class="btn btn-secondary">
            See party packages
            <Icon name="chevron-down" size={18} />
          </a>
        </div>

        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
          {
            trustPoints.map((point) => (
              <span class="inline-flex items-center gap-2 text-sm font-extrabold text-ink/75">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-paper text-ocean-dark shadow-soft ring-1 ring-ink/10">
                  <Icon name={point.icon} size={16} />
                </span>
                {point.label}
              </span>
            ))
          }
        </div>

        <p class="mt-7 flex flex-wrap items-center gap-2 text-sm font-bold text-ink/55">
          <span>Prefer to chat?</span>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-ink underline decoration-[#25d366] decoration-[3px] underline-offset-4 transition hover:decoration-ink"
          >
            <Icon name="whatsapp" size={16} class="text-[#128c4a]" />
            Message us on WhatsApp
          </a>
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-[31rem] pb-10 pl-4 sm:pl-9 lg:max-w-[34rem] lg:pb-14 lg:pl-10">
        <div class="relative">
          <div
            class="photo-frame relative ml-2 overflow-hidden rounded-t-[8rem] rounded-b-[2rem] rotate-[1.5deg] sm:ml-6 sm:rounded-t-[12rem]"
          >
            <Image
              src={heroMain}
              alt="A young maker holding a colorful flower painting at a Nashville Crafting Club party."
              widths={[420, 560, 760]}
              sizes="(max-width: 1024px) 88vw, 42vw"
              class="aspect-[4/5] w-full object-cover"
              quality={84}
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/45 to-transparent p-5 pt-16">
              <p class="text-xs font-extrabold uppercase tracking-[0.15em] text-paper">
                Real parties. Real masterpieces.
              </p>
            </div>
          </div>

          <div
            class="photo-frame absolute -bottom-4 -left-1 w-28 rotate-[-6deg] overflow-hidden rounded-2xl sm:-left-5 sm:w-36 lg:-left-7 lg:w-40"
          >
            <Image
              src={heroDetail}
              alt="A child concentrating on painting a canvas at a craft party table."
              widths={[180, 280, 380]}
              sizes="(max-width: 640px) 112px, 160px"
              class="aspect-square w-full object-cover"
              quality={82}
            />
          </div>

          <div
            class="sticker absolute -right-1 top-5 h-24 w-24 rotate-[8deg] flex-col gap-1 border-[3px] px-3 text-[0.55rem] leading-[1.2] sm:-right-3 sm:top-8 sm:h-28 sm:w-28 sm:text-[0.62rem]"
          >
            <Icon name="sparkles" size={22} class="mb-0.5" />
            <span>All supplies<br />included</span>
          </div>

          <div
            class="absolute -right-2 bottom-6 flex h-14 w-14 rotate-[-8deg] items-center justify-center rounded-full border-2 border-ink bg-mint text-ink shadow-soft sm:right-0 sm:h-16 sm:w-16"
            aria-hidden="true"
          >
            <Icon name="heart" size={24} class="fill-coral text-ink" />
          </div>
        </div>

        <svg
          class="absolute -left-3 top-1/3 h-12 w-12 rotate-[-12deg] text-ocean sm:h-14 sm:w-14"
          viewBox="0 0 48 48"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M9 39c4-11 12-20 24-27M33 12l7 1-1 8"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>
  </div>
</section>
