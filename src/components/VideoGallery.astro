---
import Icon from './Icon.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const videos = [
  {
    src: `${basePath}/videos/Sand-art.mp4`,
    title: 'Sand Art Magic',
    description: 'Watch our little artists create stunning layered sand art masterpieces.',
    badge: '✨ Fan Favorite',
  },
  {
    src: `${basePath}/videos/video-1.mp4`,
    title: 'Party in Action',
    description: 'A glimpse into the joy and creativity at a Nashville Crafting Club celebration.',
    badge: '🎉 Real Party',
  },
];
---

<section id="videos" class="section relative overflow-hidden bg-cream" aria-labelledby="videos-title">
  <!-- Decorative background -->
  <div
    class="pointer-events-none absolute -right-32 bottom-20 h-96 w-96 rounded-full bg-lilac/60 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -left-20 top-10 h-64 w-64 rounded-full bg-sun/30 blur-2xl"
    aria-hidden="true"
  ></div>
  <div class="dot-grid pointer-events-none absolute right-10 top-12 h-48 w-32 opacity-25" aria-hidden="true"></div>

  <div class="container-page relative">
    <!-- Section header -->
    <div class="reveal mx-auto mb-14 max-w-2xl text-center">
      <p class="eyebrow justify-center">See us in action</p>
      <h2 id="videos-title" class="display-title mt-5">The fun,&nbsp;on film.</h2>
      <p class="lead mt-5">
        Words can't do it justice. Watch real moments from our craft parties and see the
        smiles, the mess, and the magic.
      </p>
    </div>

    <!-- Video grid -->
    <div class="grid gap-6 sm:gap-8 lg:grid-cols-2">
      {
        videos.map((video, i) => (
          <div
            class="reveal video-card group relative overflow-hidden rounded-[2rem] border-[5px] border-paper bg-ink shadow-lift"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <!-- Play button overlay -->
            <div class="video-overlay pointer-events-none absolute inset-0 z-10 flex items-center justify-center transition duration-300">
              <span class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-paper/30 bg-paper/15 backdrop-blur-sm transition duration-300 group-hover:scale-110 group-hover:bg-paper/25">
                <Icon name="play" size={26} class="translate-x-0.5 text-paper" />
              </span>
            </div>

            <!-- Video -->
            <video
              class="video-player aspect-video w-full cursor-pointer object-cover transition duration-500 group-hover:scale-[1.02]"
              loop
              muted
              playsinline
              preload="metadata"
              aria-label={video.title}
              data-video
            >
              <source src={video.src} type="video/mp4" />
              Your browser does not support HTML5 video.
            </video>

            <!-- Info bar (slides up on hover) -->
            <div class="absolute inset-x-0 bottom-0 z-20 translate-y-full bg-gradient-to-t from-ink via-ink/90 to-transparent p-5 pt-12 transition duration-300 group-hover:translate-y-0">
              <span class="mb-2 inline-flex items-center rounded-full bg-coral/25 px-3 py-1 text-[0.65rem] font-black uppercase tracking-[0.15em] text-coral">
                {video.badge}
              </span>
              <p class="font-display text-xl font-semibold text-paper sm:text-2xl">{video.title}</p>
              <p class="mt-1 text-sm text-paper/70">{video.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTA strip -->
    <div
      class="reveal mt-12 flex flex-col items-start justify-between gap-5 rounded-[2rem] border-2 border-ink/15 bg-paper px-6 py-6 sm:flex-row sm:items-center sm:px-8"
      style="--reveal-delay: 160ms"
    >
      <div>
        <p class="font-display text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">
          Ready to create your own story?
        </p>
        <p class="mt-1.5 text-sm font-semibold text-ink/60">
          Book your craft party and let the memories roll.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="#contact" class="btn btn-primary">
          Book now
          <Icon name="arrow-right" size={17} />
        </a>
        <a href="#gallery" class="btn btn-secondary">
          See photos
          <Icon name="camera" size={17} />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const videoEls = document.querySelectorAll<HTMLVideoElement>('[data-video]');

  videoEls.forEach((videoEl) => {
    const card = videoEl.closest('.video-card') as HTMLElement | null;
    const overlay = card?.querySelector<HTMLElement>('.video-overlay');

    // Seek to 1 s once metadata is ready so the browser renders a real frame
    // instead of showing a black placeholder before the user clicks play.
    const seekToThumbnail = () => {
      if (videoEl.duration >= 1) {
        videoEl.currentTime = 1;
      } else if (videoEl.duration > 0) {
        videoEl.currentTime = videoEl.duration * 0.1;
      }
    };

    if (videoEl.readyState >= 1) {
      seekToThumbnail();
    } else {
      videoEl.addEventListener('loadedmetadata', seekToThumbnail, { once: true });
    }

    videoEl.addEventListener('click', () => {
      if (videoEl.paused) {
        // Pause all other videos
        videoEls.forEach((v) => {
          if (v !== videoEl) {
            v.pause();
            const otherCard = v.closest('.video-card') as HTMLElement | null;
            const otherOverlay = otherCard?.querySelector<HTMLElement>('.video-overlay');
            if (otherOverlay) otherOverlay.style.opacity = '1';
          }
        });
        videoEl.play();
        if (overlay) overlay.style.opacity = '0';
      } else {
        videoEl.pause();
        if (overlay) overlay.style.opacity = '1';
      }
    });

    videoEl.addEventListener('ended', () => {
      if (overlay) overlay.style.opacity = '1';
    });
  });
</script>
