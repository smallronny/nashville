---
import { getImage, Image } from 'astro:assets';
import { gallery, site } from '../data/site';
import Icon from './Icon.astro';

const aspectClasses = [
  'aspect-[4/5]',
  'aspect-square',
  'aspect-[3/4]',
  'aspect-[4/5]',
  'aspect-square',
] as const;

const fullSizeImages = await Promise.all(
  gallery.map((item) =>
    getImage({
      src: item.src,
      width: 1400,
      format: 'webp',
      quality: 88,
    }),
  ),
);

const withBase = (url: string) => {
  if (/^https?:\/\//.test(url) || url.startsWith(import.meta.env.BASE_URL)) return url;
  return `${import.meta.env.BASE_URL.replace(/\/$/, '')}${url}`;
};

const whatsappHref = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(
  "Hi Nashville Crafting Club! I'd love to plan a craft party for my celebration.",
)}`;
---

<section id="gallery" class="section relative overflow-hidden bg-cream-deep" aria-labelledby="gallery-title">
  <div
    class="dot-grid pointer-events-none absolute -left-10 top-16 h-48 w-32 opacity-30"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-24 -top-20 h-72 w-72 rounded-full bg-coral/15 blur-sm"
    aria-hidden="true"
  ></div>

  <div class="container-page relative">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Our portfolio</p>
        <h2 id="gallery-title" class="display-title mt-5">A peek inside the party.</h2>
        <p class="lead mt-5">
          Real crafts, big smiles, and a little bit of glorious mess. Here are a few favorite
          moments from our Nashville celebrations.
        </p>
      </div>

      <div
        class="reveal hidden shrink-0 items-center gap-3 rounded-full border-2 border-ink/15 bg-paper px-5 py-3 text-sm font-extrabold text-ink/70 sm:inline-flex"
        style="--reveal-delay: 80ms"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-mint">
          <Icon name="camera" size={17} />
        </span>
        {gallery.length} moments from real parties
      </div>
    </div>

    <div class="mt-12 columns-2 gap-3 sm:gap-4 lg:mt-16 lg:columns-3">
      {
        gallery.map((item, index) => (
          <button
            type="button"
            class="group mb-3 block w-full break-inside-avoid overflow-hidden rounded-[1.5rem] border-[5px] border-paper bg-paper text-left shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift focus-visible:-translate-y-1 focus-visible:shadow-lift sm:mb-4"
            aria-label={`Open larger image: ${item.caption}`}
            data-gallery-item
            data-full={withBase(fullSizeImages[index].src)}
            data-alt={item.alt}
            data-caption={item.caption}
          >
            <span class="relative block overflow-hidden rounded-[1rem] bg-cream">
              <Image
                src={item.src}
                alt={item.alt}
                widths={[320, 480, 640, 800]}
                sizes="(max-width: 640px) 46vw, (max-width: 1024px) 44vw, 29vw"
                class:list={[
                  'w-full object-cover transition duration-500 ease-out group-hover:scale-[1.04]',
                  aspectClasses[index % aspectClasses.length],
                ]}
                quality={82}
                loading="lazy"
              />
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent opacity-0 transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"></span>
              <span class="pointer-events-none absolute inset-x-0 bottom-0 flex translate-y-2 items-end justify-between gap-3 p-4 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
                <span class="text-xs font-extrabold leading-snug text-paper sm:text-sm">
                  {item.caption}
                </span>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper text-ink">
                  <Icon name="arrow-up-right" size={15} />
                </span>
              </span>
            </span>
          </button>
        ))
      }
    </div>

    <div
      class="reveal mt-12 flex flex-col items-start justify-between gap-6 rounded-[2rem] border-2 border-ink/15 bg-paper px-6 py-6 sm:flex-row sm:items-center sm:px-8"
      style="--reveal-delay: 100ms"
    >
      <div>
        <p class="font-display text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">
          Your party could be the next masterpiece.
        </p>
        <p class="mt-1.5 text-sm font-semibold text-ink/60">
          Let's make something worth hanging on the fridge.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="#contact" class="btn btn-primary">
          Plan your party
          <Icon name="arrow-right" size={17} />
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <Icon name="whatsapp" size={18} class="text-[#128c4a]" />
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label="Party photo viewer">
  <div class="overflow-hidden rounded-[1.75rem] border border-paper/20 bg-ink shadow-2xl">
    <div class="relative flex items-center justify-center bg-ink">
      <img
        src=""
        alt=""
        class="max-h-[70vh] w-full object-contain"
        data-lightbox-image
      />

      <button
        type="button"
        class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center rounded-full border border-paper/20 bg-ink/80 text-paper backdrop-blur transition hover:bg-ink focus-visible:outline-paper"
        aria-label="Close image viewer"
        data-lightbox-close
      >
        <Icon name="x" size={20} />
      </button>

      <button
        type="button"
        class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-paper/20 bg-ink/70 text-paper backdrop-blur transition hover:bg-ink focus-visible:outline-paper"
        aria-label="Previous image"
        data-lightbox-prev
      >
        <Icon name="chevron-left" size={22} />
      </button>

      <button
        type="button"
        class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-paper/20 bg-ink/70 text-paper backdrop-blur transition hover:bg-ink focus-visible:outline-paper"
        aria-label="Next image"
        data-lightbox-next
      >
        <Icon name="chevron-right" size={22} />
      </button>
    </div>

    <div class="flex items-center justify-between gap-6 border-t border-paper/15 px-5 py-4">
      <p class="text-sm font-bold text-paper/85" data-lightbox-caption aria-live="polite"></p>
      <p class="shrink-0 text-xs font-black tracking-[0.18em] text-paper/45" data-lightbox-count></p>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'),
  );

  if (dialog && triggers.length) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-count]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const prevButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    let currentIndex = 0;

    const showImage = (index: number) => {
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];

      if (image) {
        image.src = trigger.dataset.full ?? '';
        image.alt = trigger.dataset.alt ?? '';
      }
      if (caption) caption.textContent = trigger.dataset.caption ?? '';
      if (counter) counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
    };

    const openAt = (index: number) => {
      showImage(index);
      if (!dialog.open) dialog.showModal();
      document.body.classList.add('overflow-hidden');
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => openAt(index));
    });

    closeButton?.addEventListener('click', () => dialog.close());
    prevButton?.addEventListener('click', () => showImage(currentIndex - 1));
    nextButton?.addEventListener('click', () => showImage(currentIndex + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
      if (event.key === 'ArrowRight') showImage(currentIndex + 1);
    });

    dialog.addEventListener('close', () => {
      document.body.classList.remove('overflow-hidden');
    });
  }
</script>
